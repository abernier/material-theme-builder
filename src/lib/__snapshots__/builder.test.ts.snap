            "com.figma.scopes": [
              "ALL_SCOPES",
            ],
            "css.variable": "--md-sys-color-surface-container-lowest",
          },
          "$type": "color",
          "$value": "{ref.palette.Neutral.100}",
        },
        "Surface Dim": {
          "$description": "Dimmest surface variant, used for recessed areas or dark theme backgrounds.",
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES",
            ],
            "css.variable": "--md-sys-color-surface-dim",
          },
          "$type": "color",
          "$value": "{ref.palette.Neutral.87}",
        },
        "Surface Tint": {
          "$description": "Tint color applied to surfaces for subtle primary color elevation overlay.",
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES",
            ],
            "css.variable": "--md-sys-color-surface-tint",
          },
          "$type": "color",
          "$value": "{ref.palette.Primary.40}",
        },
        "Surface Variant": {
          "$description": "Alternative surface color for differentiated areas like sidebar backgrounds.",
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES",
            ],
            "css.variable": "--md-sys-color-surface-variant",
          },
          "$type": "color",
          "$value": "{ref.palette.Neutral Variant.90}",
        },
        "Tertiary": {
          "$description": "Third accent color for complementary elements that balance primary and secondary.",
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES",
            ],
            "css.variable": "--md-sys-color-tertiary",
          },
          "$type": "color",
          "$value": {
            "alpha": 1,
            "colorSpace": "srgb",
            "components": [
              0,
              0.11372549019607843,
              0.6862745098039216,
            ],
            "hex": "#001DAF",
          },
        },
        "Tertiary Container": {
          "$description": "Fill color for tertiary container elements like complementary cards.",
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES",
            ],
            "css.variable": "--md-sys-color-tertiary-container",
          },
          "$type": "color",
