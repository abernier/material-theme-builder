{
  "compilerOptions": {
    /* Path aliases (shadcn) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    /* If transpiling with TypeScript: */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  // The root configs are in here too: they are TypeScript, they import node
  // builtins, and left out they are checked by neither `pnpm typecheck` nor
  // the editor -- which falls back to an inferred project without the node
  // types and reports the builtins as missing.
  "include": [
    "src/**/*",
    "*.config.ts",
    "figma-plugin/*.config.ts",
    ".storybook/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
