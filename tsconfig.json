{
  "compilerOptions": {
    /* Path aliases (shadcn) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      /* The package's own name, back onto its sources: the `scheme` registry
         item imports it the way the projects it is copied into do. Without
         these it would resolve to `dist/` -- a second `MtbContext`, which the
         `<Mtb>` of a story or a test never provides. */
      "material-theme-builder": ["./src/index.ts"],
      "material-theme-builder/react": ["./src/react.ts"]
    },
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    /* If transpiling with TypeScript: */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  // The root configs are in here too: they are TypeScript, they import node
  // builtins, and left out they are checked by neither `pnpm typecheck` nor
  // the editor -- which falls back to an inferred project without the node
  // types and reports the builtins as missing.
  "include": [
    "src/**/*",
    "*.config.ts",
    "figma-plugin/*.config.ts",
    ".storybook/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
